---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from './Layout.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>;

const { data, render } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = data;
const { Content } = await render();

// Configuration object for "Month DD, YYYY" format
const dateOptions: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};

// Updated date formatting
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', dateOptions);

const formattedUpdatedDate = updatedDate 
  ? new Date(updatedDate).toLocaleDateString('en-US', dateOptions) 
  : undefined;
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <article class="prose">
      <h1>{title}</h1>
      <p>Published: {formattedDate}</p>
      {formattedUpdatedDate && <p>Updated: {formattedUpdatedDate}</p>}
      <br />
      <Content />
      </p>
        {tags && (
          <ul class="list-none list-inline">
            <li class="list-none list-inline tags">Tags:</li>
            {tags.map((tag: string) => (
              <li class="list-none list-inline tags">
                <a href={`/tags/${tag}`}>{tag}</a>
              </li>
            ))}
          </ul>
      )}
    </p>
    </article>
  </main>
  <Footer />
</Layout>