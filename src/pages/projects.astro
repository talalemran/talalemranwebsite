---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';

const pageTitle = "Talal Emran - My Projects";
const pageDescription = "Explore the projects by Talal Emran, a web designer and developer based in Ottawa, Canada. Discover innovative web design and development solutions.";
const projects = [
  {
    title: "UpNorthHub",
    desc: "A WordPress-powered website for a Northern Ontario business.",
    url: "https://www.upnorthhub.com",
    tech: "WordPress",
  },
  {
    title: "Maestro Barbershop",
    desc: "A modern website for a local barbershop in Ottawa.",
    url: "https://maestrobarbershop.ca/",
    tech: "HTML / CSS / JavaScript",
  },
  {
    title: "Most Logic Studio",
    desc: "A WordPress website for a creative studio.",
    url: "https://www.mostlogicstudio.com",
    tech: "WordPress",
  },
  {
    title: "My Old Website",
    desc: "Previous version of my personal website.",
    url: "https://myoldwebsite77.netlify.app/",
    tech: "HTML / CSS / JavaScript",
  },
  {
    title: "Super Tire",
    desc: "Web project for Super Tire Auto tire installation based in Ottawa, Ontario.",
    url: "https://supertire.netlify.app/",
    tech: "HTML / CSS / JavaScript",
  },
  {
    title: "Discover Canada",
    desc: "Web project about Canada with information and gallery.",
    url: "https://discovercanada.netlify.app/",
    tech: "HTML / CSS / JavaScript",
  },
  {
    title: "Flex Fit",
    desc: "Website project about Gym for Flex Fit in black and yellow color.",
    url: "https://flexfit77.netlify.app/",
    tech: "HTML / CSS / JavaScript",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
    <Header/>
<div>
    <main>
        <h1>My Projects</h1>
        <p>Here are some of my recent projects that I have worked on. I have experience in web design, development, graphic design, and photography.</p>

        <div class="project-grid">
            {projects.map((p) => (
                <a href={p.url} target="_blank" class="project-block">
                    <div class="block-bar"></div>
                    <div class="block-body">
                        <h2>{p.title}</h2>
                        <p>{p.desc}</p>
                        <span class="block-tech">{p.tech}</span>
                    </div>
                </a>
            ))}
        </div>
    </main>
</div>
<Footer/>
</Layout>

<style>
    .project-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 2rem;
    }
    .project-block {
        display: block;
        text-decoration: none;
        color: inherit;
        border: 1px solid #e0d6b8;
        border-radius: 8px;
        overflow: hidden;
        transition: box-shadow 0.2s ease;
        background-color: rgba(255, 255, 255, 0.5);
    }
    .project-block:hover {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
    .block-bar {
        height: 4px;
        background-color: var(--secondary-color);
    }
    .block-body {
        padding: 1.25rem;
    }
    .project-block h2 {
        margin-bottom: 0.4rem;
        border: none;
        padding: 0;
        display: block;
    }
    .project-block p {
        margin-bottom: 0.75rem;
    }
    .block-tech {
        font-weight: bold;
        color: var(--primary-color);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    @media (max-width: 768px) {
        .project-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
